APP_NAME="PT Wira Griya"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-project.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Current public website pages do not persist inquiry data in a database.
# SQLite is only a local/temporary fallback; use managed database storage
# before introducing persistent accounts, comments, or admin records.
DB_CONNECTION=sqlite
DB_DATABASE=/tmp/database.sqlite
DB_FOREIGN_KEYS=true

# Stateless-friendly settings for serverless/container deployment.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=log

# Configure these values using your company's authenticated SMTP mailbox.
# MAIL_FROM_ADDRESS must be an address permitted by the SMTP provider.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=verified-sender@wira.co.id
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_INQUIRY_TO=info@wira.co.id

VITE_APP_NAME="${APP_NAME}"
